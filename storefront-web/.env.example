# Server only. Do not prefix with NEXT_PUBLIC_ or forward browser credentials.
STOREFRONT_API_ORIGIN=http://127.0.0.1:8080

# Server only, >= 32 characters, never versioned. Signs the visitor IP sent to the backend
# checkout (ADR-0012 D4); must match STOREFRONT_FORWARDING_SECRET of the backend. Empty: the
# backend limits by connection address. Used by the checkout (SC-009).
STOREFRONT_FORWARDING_SECRET=

# Server only. "true" shows the checkout (ADR-0012 D6: DEV/local only until payments exist).
# Any other value hides the link and makes the checkout route 404.
STOREFRONT_CHECKOUT_ENABLED=

# Server only. Set "true" only behind a proxy that overwrites X-Forwarded-For; otherwise a
# visitor could choose the IP the backend limits by. Empty: no visitor IP is sent.
STOREFRONT_TRUST_FORWARDED_FOR=
