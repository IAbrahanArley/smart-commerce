# API local acessível por /api via rewrite para http://127.0.0.1:8080.
# Execute o admin em http://127.0.0.1:3000 (mesma origem autorizada no backend).
# Nunca coloque credenciais ou tokens em variáveis NEXT_PUBLIC_*.

# Origem pública separada para não compartilhar cookies host-only do admin local.
NEXT_PUBLIC_STOREFRONT_ORIGIN=http://localhost:3001

# Server/build only (ADR-0014). Backend origin for the /api rewrite: HTTPS, or HTTP only on
# loopback. Empty keeps http://127.0.0.1:8080; an invalid value fails the build.
ADMIN_API_ORIGIN=

